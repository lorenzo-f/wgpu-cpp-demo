  var Vvec : vec3f;
  var V : vec3f;
  var lenV : f32;
  var Hvec : vec3f;
  var H : vec3f;
  var lenH : f32;
  var diff : f32;
  var spec : f32;
  var nh : f32;
  var lightCol : vec3f;
  var ambientCol : vec3f;
  var diffuseCol : vec3f;
  var specularCol : vec3f;
  var finalColor : vec3f;
  var x_123 : bool;
  var x_124 : bool;
  N = normalize(vNormal);
  Lvec = (light.position.xyz - vWorldPos);
  L = vec3f();
  lenL = length(Lvec);
  if ((lenL > 0.00000099999999747524f)) {
    L = (Lvec / vec3f(lenL));
  }
  attenuation = (1.0f / ((light.attenuation.x + (light.attenuation.y * lenL)) + (light.attenuation.z * (lenL * lenL))));
  Vvec = (camera.uCameraPos.xyz - vWorldPos);
  V = vec3f();
  lenV = length(Vvec);

  N = normalize(vNormal);
  L = normalize((light.position.xyz - vWorldPos));
  V = normalize((camera.uCameraPos.xyz - vWorldPos));
  H = normalize((L + V));
  diff = max(dot(N, L), 0.0f);
  spec = pow(max(dot(N, H), 0.0f), material.shininess);
  lightCol = (light.colorIntensity.xyz * light.colorIntensity.w);
  ambientCol = (material.ambient.xyz * light.globalAmbient.xyz);
  diffuseCol = (material.diffuse.xyz * diff);
  specularCol = (material.specular.xyz * spec);
  finalColor = ((material.emission.xyz + ambientCol) + ((diffuseCol + specularCol) * lightCol));
  outColor = vec4f(finalColor.x, finalColor.y, finalColor.z, 1.0f);
  return;
}


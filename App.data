  ambientCol = (material.ambient.xyz * light.globalAmbient.xyz);
  diffuseCol = (material.diffuse.xyz * diff);
  specularCol = (material.specular.xyz * spec);
  finalColor = ((material.emission.xyz + ambientCol) + ((diffuseCol + specularCol) * lightCol));
